{
  "name": "@pixel-perfect-software/always-up-to-date",
  "version": "4.1.1",
  "author": "Tyler Robertson <@tylernrobertson> (https://github.com/TylerNRobertson)",
  "description": "A configurable CLI that keeps the dependencies of npm, pnpm, yarn and bun projects up to date.",
  "license": "MIT",
  "main": "dist/index.js",
  "files": ["dist/**/*", "schema/**/*", "README.md", "LICENSE"],
  "scripts": {
    "build": "node scripts/build.mts",
    "check-types": "tsc --noEmit && tsc -p scripts",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write",
    "prepack": "pnpm run build",
    "test": "jest --silent",
    "test:integration": "pnpm run build && jest --config jest.integration.config.ts",
    "bench": "pnpm run build && node -r ./bench/register.cjs bench/run.ts",
    "bench:gate": "pnpm run build && node -r ./bench/register.cjs bench/gate.ts",
    "test:coverage": "jest --coverage --silent",
    "test:badges": "pnpm test:coverage && jest-coverage-badges --output ./badges",
    "clean": "rm -rf dist",
    "autd": "node dist/index.js"
  },
  "bin": {
    "autd": "dist/index.js",
    "alwaysuptodate": "dist/index.js",
    "always-up-to-date": "dist/index.js"
  },
  "bugs": {
    "url": "https://github.com/pixel-perfect-software/always-up-to-date/issues"
  },
  "homepage": "https://github.com/pixel-perfect-software/always-up-to-date#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixel-perfect-software/always-up-to-date.git"
  },
  "engines": {
    "node": "^22.23.0 || >=24.17.0",
    "pnpm": ">=12.0.0"
  },
  "keywords": [
    "npm",
    "dependencies",
    "updater",
    "automation",
    "cli",
    "package-manager",
    "dependency-management",
    "maintenance",
    "pnpm",
    "yarn",
    "bun",
    "checker"
  ],
  "dependencies": {
    "@inquirer/prompts": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "ajv": "catalog:",
    "colorette": "catalog:",
    "commander": "catalog:",
    "esbuild": "catalog:",
    "jest": "catalog:",
    "jest-coverage-badges": "catalog:",
    "semver": "catalog:",
    "typescript": "catalog:"
  }
}
