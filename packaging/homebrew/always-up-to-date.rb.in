# Generated by always-up-to-date's release workflow from packaging/homebrew/always-up-to-date.rb.in.
# Edit the template there, not this file.
class AlwaysUpToDate < Formula
  desc "Configurable CLI that keeps npm, pnpm, yarn and bun dependencies up to date"
  homepage "https://github.com/pixel-perfect-software/always-up-to-date"
  license "MIT"

  livecheck do
    url :stable
    strategy :github_latest
  end

  on_macos do
    on_arm do
      url "@BASE_URL@/always-up-to-date-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA_AARCH64_APPLE_DARWIN@"
    end
    on_intel do
      url "@BASE_URL@/always-up-to-date-@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA_X86_64_APPLE_DARWIN@"
    end
  end

  on_linux do
    on_intel do
      url "@BASE_URL@/always-up-to-date-@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA_X86_64_UNKNOWN_LINUX_GNU@"
    end
    on_arm do
      url "@BASE_URL@/always-up-to-date-@VERSION@-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA_AARCH64_UNKNOWN_LINUX_GNU@"
    end
  end

  def install
    bin.install "autd"
    bin.install_symlink "autd" => "alwaysuptodate"
    bin.install_symlink "autd" => "always-up-to-date"
    prefix.install "LICENSE", "third-party-licenses.txt", "BUN-LICENSE.md"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/autd --version")
    assert_match version.to_s, shell_output("#{bin}/alwaysuptodate --version")
  end
end
